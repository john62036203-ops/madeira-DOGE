diff --git a/src/validation.c b/src/validation.c
index cf6acfe..b014316 100644
--- a/src/validation.c
+++ b/src/validation.c
@@ -196,3 +196,18 @@ const char *sh_install_scm_word(int32_t outcome)
     default: return "failed";
     }
 }
+
+bool sh_parse_launch_option(const wchar_t *text, uint32_t *option)
+{
+    if (!option) return false;
+    uint32_t value = 0;
+    if (text) {
+        for (size_t i = 0; text[i]; ++i) {
+            if (i >= 4 || text[i] < L'0' || text[i] > L'9') return false;
+            value = value * 10 + (uint32_t)(text[i] - L'0');
+        }
+        if (value > SH_LAUNCH_OPTION_MAX) return false;
+    }
+    *option = value;
+    return true;
+}
